*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.Python
*.egg-info/
.eggs/
dist/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.ipynb_checkpoints/

# ===== Supabase CLI (local dev) =====
supabase/.branches/
supabase/.temp/
.supabase/


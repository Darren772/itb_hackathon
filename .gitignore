node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ===== Backend: Python / FastAPI =====
